local function createGroupBox(parent, titleText)
    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 0, 0)
    box.AutomaticSize = Enum.AutomaticSize.Y
    box.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    box.BorderSizePixel = 0
    box.Parent = parent
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = OutlineBlue
    stroke.Thickness = 1
    stroke.Parent = box
    
    local label = Instance.new("TextLabel")
    label.Text = " " .. titleText
    label.Size = UDim2.new(1, 0, 0, 20)
    label.BackgroundTransparency = 1
    label.TextColor3 = TextWhite
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Code
    label.TextSize = 13
    label.Parent = box
    
    local line = Instance.new("Frame")
    line.Size = UDim2.new(1, 0, 0, 1)
    line.Position = UDim2.new(0, 0, 0, 20)
    line.BackgroundColor3 = OutlineBlue
    line.BorderSizePixel = 0
    line.Parent = box
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -10, 0, 0)
    container.Position = UDim2.new(0, 5, 0, 25)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.BackgroundTransparency = 1
    container.Parent = box
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = container

    local pad = Instance.new("UIPadding")
    pad.PaddingBottom = UDim.new(0, 8)
    pad.Parent = container
    
    return container
end

local function createToggle(parent, text)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 22)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = parent
    
    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 14, 0, 14)
    box.Position = UDim2.new(0, 0, 0.5, -7)
    box.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    box.BorderSizePixel = 0
    box.Parent = button
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(100, 100, 100)
    stroke.Parent = box
    
    local checkMark = Instance.new("Frame")
    checkMark.Size = UDim2.new(1, -4, 1, -4)
    checkMark.Position = UDim2.new(0, 2, 0, 2)
    checkMark.BackgroundColor3 = OutlineBlue
    checkMark.BorderSizePixel = 0
    checkMark.Visible = false
    checkMark.Parent = box
    
    local label = Instance.new("TextLabel")
    label.Text = text
    label.Size = UDim2.new(1, -22, 1, 0)
    label.Position = UDim2.new(0, 22, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = TextWhite
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Code
    label.TextSize = 12
    label.Parent = button

    local state = false
    button.Activated:Connect(function()
        state = not state
        checkMark.Visible = state
    end)
end

