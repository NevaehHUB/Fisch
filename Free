local function pv(fn, ...)
	local ok, v = pcall(fn, ...)
	if ok then return v end
	return nil
end

local function money() return tonumber(pv(function() return D.Money() end)) or 0 end
local function inventory() return pv(function() return D.Inventory() end) or {} end
local function slots() return pv(function() return D.Slots() end) or {} end
local function buff(name) return BuffC and tonumber(pv(BuffC.GetBuff, name)) or nil end
local function inventoryCap() return buff("Unit Storage") or 100 end

local function amountOf(name)
	local total = 0
	for _, e in pairs(inventory()) do
		if e.name == name then total = total + (tonumber(e.amount) or 0) end
	end
	return total
end

local function chanceOf(cfg, attrs) return tonumber(pv(cfg.chance, attrs)) or 0 end
local function rarityOrder(name)
	if Rar and Rar.Get and name then
		local r = pv(Rar.Get, name)
		if type(r) == "table" and tonumber(r.sortOrder) then return tonumber(r.sortOrder) end
	end
	return 1
end
local function plottedKeys()
	local set = {}
	for _, s in pairs(slots()) do
		if type(s) == "table" and s.unitId then set[s.unitId] = true end
	end
	return set
end

local function unitEntries()
	local out = {}
	if not ER then return out end
	for key, e in pairs(inventory()) do
		local cfg = ER.getEntryConfig(e.name)
		if cfg and cfg.kind == "Unit" then
			local attrs = e.attributes or {}
			table.insert(out, {
				key = key, name = e.name, attrs = attrs, cfg = cfg,
				income = tonumber(pv(cfg.income, attrs)) or 0,
				chance = chanceOf(cfg, attrs),
				amount = tonumber(e.amount) or 1,
			})
		end
	end
	return out
end

