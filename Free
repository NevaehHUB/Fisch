-- Isolated from the pcall above so if that fails we still try
local function buildCustomButtons()
    local ICON_COLOR   = Color3.fromRGB(148, 203, 255)
    local BG_COLOR     = Color3.fromRGB(15, 15, 20)
    local BG_HOVER     = Color3.fromRGB(30, 30, 40)
    local LOCKED_COLOR = Color3.fromRGB(255, 90, 110)

    local sg = Instance.new("ScreenGui")
    sg.Name = "ClimaMobileButtons"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder = 9999

    local ok = pcall(function() sg.Parent = gethui() end)
    if not ok then
        ok = pcall(function() sg.Parent = game:GetService("CoreGui") end)
    end
    if not ok then
        pcall(function() sg.Parent = LocalPlayer:WaitForChild("PlayerGui", 5) end)
    end

    -- ---- Draggable container (so user can move buttons) ----
    local container = Instance.new("Frame")
    container.Name = "Container"
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(0, 90, 0, 45)
    container.Position = UDim2.new(1, -105, 0, 80) -- top-right
    container.Parent = sg

    local dragActive = false
    local dragStart, startPos

    -- ---- Build a button helper ----
    local function makeBtn(name, size, pos)
        local btn = Instance.new("ImageButton")
        btn.Name = name
        btn.Size = size
        btn.Position = pos
        btn.BackgroundColor3 = BG_COLOR
        btn.BackgroundTransparency = 0.15
        btn.BorderSizePixel = 0
        btn.Image = ""  -- we draw with primitives
        btn.AutoButtonColor = false
        btn.Parent = container

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = ICON_COLOR
        stroke.Thickness = 1.5
        stroke.Transparency = 0.2
        stroke.Parent = btn

        btn.MouseEnter:Connect(function()
            btn.BackgroundColor3 = BG_HOVER
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundColor3 = BG_COLOR
        end)

        return btn, stroke
    end

    -- ---- Custom drawn icons (scaled for a 40x40 button) ----
    local function clearIcon(btn)
        for _, c in ipairs(btn:GetChildren()) do
            if c.Name == "IconRoot" then c:Destroy() end
        end
    end

    local function iconSizes(btn)
        local s = btn.AbsoluteSize.X
        if not s or s < 5 then s = 40 end
        return s, math.max(1.5, s * (2/24)), math.max(2, s * (2/24))
    end

    -- Lock icon (closed padlock)
    local function drawLockIcon(btn, open)
        clearIcon(btn)
        local S, TH, R = iconSizes(btn)

        local root = Instance.new("Frame")
        root.Name = "IconRoot"
        root.BackgroundTransparency = 1
        root.Size = UDim2.fromScale(1, 1)
        root.Parent = btn

        -- Body
        local body = Instance.new("Frame")
        body.BackgroundTransparency = 1
        body.Position = UDim2.fromScale(5/24, 10/24)
        body.Size     = UDim2.fromScale(14/24, 10/24)
        body.Parent   = root
        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, R)
        bc.Parent = body
        local bs = Instance.new("UIStroke")
        bs.Color = ICON_COLOR
        bs.Thickness = TH
        bs.Parent = body

        -- Keyhole dot
        local dot = Instance.new("Frame")
        dot.BackgroundColor3 = ICON_COLOR
        dot.BorderSizePixel = 0
        dot.Position = UDim2.fromScale(11/24, 14/24)
        dot.Size     = UDim2.fromScale(2/24, 2/24)
        dot.Parent   = root
        local dc = Instance.new("UICorner")
        dc.CornerRadius = UDim.new(1, 0)
        dc.Parent = dot

        -- Shackle arc (top half circle)
        local clipW = open and (7/24) or (8/24)
        local clip = Instance.new("Frame")
        clip.BackgroundTransparency = 1
        clip.Position = UDim2.fromScale(8/24, 3/24)
        clip.Size     = UDim2.fromScale(clipW, 4/24)
        clip.ClipsDescendants = true
        clip.Parent = root

        local arc = Instance.new("Frame")
        arc.BackgroundTransparency = 1
        arc.Size = UDim2.new((8/24) / clipW, 0, 2, 0)
        arc.Parent = clip
        local ac = Instance.new("UICorner")
        ac.CornerRadius = UDim.new(1, 0)
        ac.Parent = arc
        local as_ = Instance.new("UIStroke")
        as_.Color = ICON_COLOR
        as_.Thickness = TH
        as_.Parent = arc

        -- Vertical drops
        local function drop(x)
            local l = Instance.new("Frame")
            l.BackgroundColor3 = ICON_COLOR
            l.BorderSizePixel = 0
            l.Position = UDim2.new(x, -TH/2, 7/24, 0)
            l.Size     = UDim2.new(0, TH, 3/24, 0)
            l.Parent   = root
        end
        drop(8/24)
        if not open then drop(16/24) end
    end

    -- Dashboard icon (4 rects)
    local function drawDashIcon(btn)
        clearIcon(btn)
        local S, TH, R = iconSizes(btn)

        local root = Instance.new("Frame")
        root.Name = "IconRoot"
        root.BackgroundTransparency = 1
        root.Size = UDim2.fromScale(1, 1)
        root.Parent = btn

        local function box(x, y, w, h)
            local f = Instance.new("Frame")
            f.BackgroundTransparency = 1
            f.Position = UDim2.fromScale(x, y)
            f.Size     = UDim2.fromScale(w, h)
            f.Parent   = root
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, math.max(1, R * 0.5))
            c.Parent = f
            local s = Instance.new("UIStroke")
            s.Color = ICON_COLOR
            s.Thickness = TH
            s.Parent = f
        end

        box( 6/24,  6/24, 5/24, 8/24)
        box(13/24,  6/24, 5/24, 4/24)
        box(13/24, 12/24, 5/24, 8/24)
        box( 6/24, 16/24, 5/24, 4/24)
    end

    -- ---- Create the two buttons ----
    local toggleBtn, toggleStroke = makeBtn("ClimaToggleBtn", UDim2.new(0, 40, 0, 40), UDim2.new(0, 0, 0, 0))
    local lockBtn,   lockStroke   = makeBtn("ClimaLockBtn",   UDim2.new(0, 40, 0, 40), UDim2.new(0, 48, 0, 0))

    drawDashIcon(toggleBtn)
    drawLockIcon(lockBtn, false)

    print("[Clima] Custom buttons built")

    -- ---- Behavior ----
    local windowVisible = true
    local locked = false

    -- Helper: hide/show the main window
    local function setMainWindowVisible(v)
        local ok1 = pcall(function()
            if v then Window:Show() else Window:Hide() end
        end)
        if not ok1 then
            pcall(function()
                if Window.SetVisible then
                    Window:SetVisible(v)
                elseif Window.Visible ~= nil then
                    Window.Visible = v
                end
            end)
        end
        windowVisible = v
    end

    -- Toggle button click
    toggleBtn.MouseButton1Click:Connect(function()
        if locked then return end -- locked, ignore toggle
        setMainWindowVisible(not windowVisible)
    end)

    -- Lock button click — "locks" the toggle button away
    local lockOpenState = false
    lockBtn.MouseButton1Click:Connect(function()
        locked = not locked
        lockOpenState = locked
        drawLockIcon(lockBtn, lockOpenState)
        if locked then
            -- Locking: hide main window and disable toggle button
            toggleBtn.BackgroundTransparency = 0.7
            toggleStroke.Color = Color3.fromRGB(100, 100, 100)
            lockStroke.Color = Color3.fromRGB(255, 90, 110)
            setMainWindowVisible(false)
        else
            -- Unlocking: restore toggle button
            toggleBtn.BackgroundTransparency = 0.15
            toggleStroke.Color = ICON_COLOR
            lockStroke.Color = ICON_COLOR
            setMainWindowVisible(true)
        end
    end)

    -- ---- Dragging support ----
    local function isOnContainer(inputPos)
        local ap = container.AbsolutePosition
        local as = container.AbsoluteSize
        return inputPos.X >= ap.X and inputPos.X <= ap.X + as.X
           and inputPos.Y >= ap.Y and inputPos.Y <= ap.Y + as.Y
    end

    local dragStartPos
    local dragStartTouch

    local function onInputBegan(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            local pos = Vector2.new(input.Position.X, input.Position.Y)
            if isOnContainer(pos) then
                dragStartTouch = pos
                dragStartPos = container.Position
            end
        end
    end

    local function onInputChanged(input)
        if input.UserInputType == Enum.UserInputType.Touch and dragStartTouch then
            local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStartTouch
            container.Position = UDim2.new(
                dragStartPos.X.Scale, dragStartPos.X.Offset + delta.X,
                dragStartPos.Y.Scale, dragStartPos.Y.Offset + delta.Y
            )
        end
    end

    local function onInputEnded(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragStartTouch = nil
        end
    end

    UserInputService.InputBegan:Connect(onInputBegan)
    UserInputService.InputChanged:Connect(onInputChanged)
    UserInputService.InputEnded:Connect(onInputEnded)

    print("[Clima] Custom buttons wired up")
end

pcall(buildCustomButtons)
print("[Clima] Custom button block finished")

