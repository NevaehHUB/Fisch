    layout.Parent = container

    local pad = Instance.new("UIPadding")
    pad.PaddingBottom = UDim.new(0, 10)
    pad.Parent = container
    
    return container
end

local function createToggle(parent, text)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 32) -- Increased for touch
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = parent
    
    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 20, 0, 20)
    box.Position = UDim2.new(0, 5, 0.5, -10)
    box.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    box.BorderSizePixel = 0
    box.Parent = button
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(100, 100, 100)
    stroke.Parent = box
    
    local checkMark = Instance.new("Frame")
    checkMark.Size = UDim2.new(1, -6, 1, -6)
    checkMark.Position = UDim2.new(0, 3, 0, 3)
    checkMark.BackgroundColor3 = OutlineCyan
    checkMark.BorderSizePixel = 0
    checkMark.Visible = false
    checkMark.Parent = box
    
    local label = Instance.new("TextLabel")
    label.Text = text
    label.Size = UDim2.new(1, -35, 1, 0)
    label.Position = UDim2.new(0, 35, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = TextWhite
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Code
    label.TextSize = 13
    label.Parent = button

    local state = false
    button.Activated:Connect(function()
        state = not state
        checkMark.Visible = state
        stroke.Color = state and OutlineCyan or Color3.fromRGB(100, 100, 100)
    end)
end

