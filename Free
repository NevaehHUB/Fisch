-- Execute this in your Roblox executor
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Check if the player is on a mobile/touch device
local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Dynamic sizing: Larger for PC, compact for Mobile
local windowSize = isMobile and UDim2.fromOffset(480, 280) or UDim2.fromOffset(800, 500)

local MacLib = loadstring(game:HttpGet("https://github.com/biggaboy212/Maclib/releases/latest/download/maclib.txt"))()

-- Create the main window
local Window = MacLib:Window({
    Title = "Power",
    Subtitle = "I love naughty things",
    Size = windowSize,
    DragStyle = 1,
    AcrylicBlur = true,
})

local TabGroup = Window:TabGroup()

-- 1. Create Tabs
local FishingTab = TabGroup:Tab({ Name = "Fishing", Image = "rbxassetid://10734950309" })
local PlayerTab = TabGroup:Tab({ Name = "Player", Image = "rbxassetid://10734950309" })

-- 2. Create Sections inside the Fishing Tab
local FishingMain = FishingTab:Section({ Side = "Left" })
local FishingSettings = FishingTab:Section({ Side = "Right" })

-- 3. Add Groups/Headers and Elements (Toggles & Inputs)
FishingMain:Header({ Name = "Fishing Automation" })

FishingMain:Toggle({
    Name = "Auto Fish",
    Description = "Fishes for you",
    Default = false,
    Callback = function(Value)
        print("Auto Fish toggled:", Value)
    end
})

FishingMain:Toggle({
    Name = "Auto Cast Rod",
    Description = "Casts for you",
    Default = false,
    Callback = function(Value)
        print("Auto Cast Rod toggled:", Value)
    end
})

FishingMain:Toggle({
    Name = "Auto Buy Bait",
    Description = "Buys bait for you",
    Default = false,
    Callback = function(Value)
        print("Auto Buy Bait toggled:", Value)
    end
})

FishingSettings:Header({ Name = "Configuration" })

FishingSettings:Input({
    Name = "Amount to buy",
    Description = "How much to buy",
    Placeholder = "3",
    Numeric = true,
    Callback = function(Value)
        print("Amount set to:", Value)
    end
})

FishingSettings:Input({
    Name = "Interval (seconds)",
    Description = "How often",
    Placeholder = "5",
    Numeric = true,
    Callback = function(Value)
        print("Interval set to:", Value)
    end
})

-- 4. Set up the Player Settings Tab
local PlayerMain = PlayerTab:Section({ Side = "Left" })

PlayerMain:Header({ Name = "Movement Options" })

PlayerMain:Toggle({
    Name = "Freeze Character",
    Description = "Stops you from moving",
    Default = false,
    Callback = function(Value)
        print("Freeze Character toggled:", Value)
    end
})

-- 5. Mobile Floating Toggle Button (ONLY for Mobile/Android users)
if isMobile then
    task.spawn(function()
        pcall(function()
            local screenGui = Instance.new("ScreenGui")
            screenGui.Name = "PowerMobileToggle"
            screenGui.ResetOnSpawn = false
            screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            
            local parent = (gethui and gethui()) or CoreGui:FindFirstChild("RobloxGui") or LocalPlayer:FindFirstChildOfClass("PlayerGui")
            screenGui.Parent = parent

            local imageButton = Instance.new("ImageButton")
            imageButton.Name = "ToggleButton"
            imageButton.Size = UDim2.new(0, 55, 0, 55)
            imageButton.Position = UDim2.new(0, 20, 0.5, -27)
            imageButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            imageButton.BorderSizePixel = 0
            imageButton.Draggable = true
            imageButton.Parent = screenGui

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = imageButton

            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.fromRGB(255, 75, 100) -- Reddish/Pink theme accent
            stroke.Thickness = 2.5
            stroke.Parent = imageButton

            -- Download and load image link for mobile executors
            local imageUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSJX2VMQVfhhlz768cP2LOCNukvXQTHB1mp8o-sIlS8dzqng1MT7OZVuvjN&s=10"
            if writefile and (getcustomasset or getsynasset) then
                local success, data = pcall(function()
                    return game:HttpGet(imageUrl)
                end)
                if success and data then
                    local filename = "power_icon_" .. math.random(10000, 99999) .. ".png"
                    writefile(filename, data)
                    local assetFunc = getcustomasset or getsynasset
                    pcall(function()
                        imageButton.Image = assetFunc(filename)
                    end)
                end
            end

            -- Working toggle function that finds and toggles the UI window
            local isOpen = true
            imageButton.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                for _, gui in ipairs({CoreGui, LocalPlayer:FindFirstChild("PlayerGui")}) do
                    if gui then
                        for _, desc in ipairs(gui:GetDescendants()) do
                            if desc:IsA("TextLabel") and desc.Text == "Power" then
                                local parentFrame = desc.Parent
                                while parentFrame and parentFrame ~= gui do
                                    if parentFrame:IsA("Frame") and parentFrame.Size.X.Offset > 300 then
                                        parentFrame.Visible = isOpen
                                        break
                                    end
                                    parentFrame = parentFrame.Parent
                                end
                            end
                        end
                    end
                end
            end)
        end)
    end)
end

-- Execution notification
Window:Notify({
    Title = "Power",
    Description = "Thanks for executing Daddy",
    Lifetime = 10
})
