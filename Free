--  BLUE/CYAN OUTLINE
-- ============================================================
pcall(function()
    task.spawn(function()
        task.wait(0.2)
        local cyan = Color3.fromRGB(0, 229, 255)
        local n = 0
        for _, obj in ipairs(game:GetDescendants()) do
            if obj:IsA("UIStroke") then
                obj.Color = cyan
                obj.Transparency = math.min(obj.Transparency, 0.2)
                obj.Thickness = math.max(obj.Thickness, 1)
                n = n + 1
            end
        end
        print("[Clima] Recolored", n, "UIStrokes to cyan")
    end)
end)

-- ============================================================
--  ICON PATCHER — FULLY ISOLATED
--  Wrapped in a single pcall. If ANYTHING fails, the menu
--  still works perfectly. Icons just stay default.
-- ============================================================
pcall(function()
    task.spawn(function()
        task.wait(2)

        local ICON_COLOR = Color3.fromRGB(148, 203, 255)

        -- ---- Collect every ImageButton we can find ----
        local btns = {}
        local seen = {}

        local function scan(root)
            if not root then return end
            local ok, list = pcall(function() return root:GetDescendants() end)
            if not ok or not list then return end
            for _, obj in ipairs(list) do
                if obj:IsA("ImageButton") and not seen[obj] then
                    seen[obj] = true
                    table.insert(btns, obj)
                end
            end
        end

        pcall(scan, game)
        if gethui then pcall(function() scan(gethui()) end) end
        pcall(function() scan(game:GetService("CoreGui")) end)
        pcall(function() scan(game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui", 5)) end)

        print("[Clima] Scanned ImageButtons:", #btns)
        for i, b in ipairs(btns) do
            print("  [" .. i .. "] " .. b.Name .. " (" .. tostring(b.AbsoluteSize.X) .. "px) :: " .. b:GetFullName())
        end

        -- ---- Match lock + toggle by name ----
        local lockBtn, toggleBtn
        for _, b in ipairs(btns) do
            local n = b.Name:lower()
            if not lockBtn and n:find("lock") then lockBtn = b end
            if not toggleBtn and (n:find("toggle") or n:find("mobile") or n:find("showhide")) then
                toggleBtn = b
            end
        end

        -- ---- Drawing helpers ----
        local function bsize(b)
            local s = b.AbsoluteSize.X
            if not s or s < 5 then s = 24 end
            return s
        end
        local function thick(b) return math.max(1.5, bsize(b) * (2/24)) end
        local function corner(b, r) return math.max(2, bsize(b) * (r/24)) end

        local function clearIcon(b, tag)
            for _, c in ipairs(b:GetChildren()) do
                if c.Name == tag then c:Destroy() end
            end
        end

        local function prepButton(b)
            pcall(function() b.Image = "" end)
            pcall(function() b.ImageTransparency = 1 end)
            pcall(function() b.BackgroundTransparency = 1 end)
            pcall(function() b.ClipsDescendants = false end)
            pcall(function() b.AutoButtonColor = false end)
            for _, c in ipairs(b:GetDescendants()) do
                if c ~= b then
                    if c:IsA("ImageLabel") or c:IsA("ImageButton") then
                        pcall(function() c.Image = "" end)
                        pcall(function() c.ImageTransparency = 1 end)
                        pcall(function() c.Visible = false end)
                    elseif c:IsA("TextLabel") or c:IsA("TextButton") then
                        pcall(function() c.TextTransparency = 1 end)
                        pcall(function() c.Visible = false end)
                    end
                end
            end
        end

        -- ---- Draw lock icon ----
        local function drawLock(b, isOpen)
            clearIcon(b, "ClimaLock")
            prepButton(b)
            local TH = thick(b)

            local icon = Instance.new("Frame")
            icon.Name = "ClimaLock"
            icon.BackgroundTransparency = 1
            icon.Size = UDim2.fromScale(1, 1)
            icon.ZIndex = 500
            icon.Parent = b

            -- Body (rounded rect outline)
            local body = Instance.new("Frame")
            body.BackgroundTransparency = 1
            body.Position = UDim2.fromScale(3/24, 10/24)
            body.Size     = UDim2.fromScale(18/24, 12/24)
            body.ZIndex   = 501
            body.Parent   = icon
            local bc = Instance.new("UICorner")
            bc.CornerRadius = UDim.new(0, corner(b, 2))
            bc.Parent = body
            local bs = Instance.new("UIStroke")
            bs.Color = ICON_COLOR
            bs.Thickness = TH
            bs.Parent = body

            -- Keyhole dot
            local dot = Instance.new("Frame")
            dot.BackgroundColor3 = ICON_COLOR
            dot.BorderSizePixel = 0
            dot.Position = UDim2.fromScale(11/24, 15/24)
            dot.Size     = UDim2.fromScale(2/24, 2/24)
            dot.ZIndex   = 502
            dot.Parent   = icon
            local dc = Instance.new("UICorner")
            dc.CornerRadius = UDim.new(1, 0)
            dc.Parent = dot

            -- Shackle (top half-circle)
            local clipW = isOpen and (9/24) or (10/24)
            local clip = Instance.new("Frame")
            clip.BackgroundTransparency = 1
            clip.Position = UDim2.fromScale(7/24, 2/24)
            clip.Size     = UDim2.fromScale(clipW, 5/24)
            clip.ClipsDescendants = true
            clip.ZIndex = 501
            clip.Parent = icon

            local arc = Instance.new("Frame")
            arc.BackgroundTransparency = 1
            arc.Size = UDim2.new((10/24) / clipW, 0, 2, 0)
            arc.ZIndex = 502
            arc.Parent = clip
            local ac = Instance.new("UICorner")
            ac.CornerRadius = UDim.new(1, 0)
            ac.Parent = arc
            local as_ = Instance.new("UIStroke")
            as_.Color = ICON_COLOR
            as_.Thickness = TH
            as_.Parent = arc

            -- Vertical drops
            local function drop(x)
                local l = Instance.new("Frame")
                l.BackgroundColor3 = ICON_COLOR
                l.BorderSizePixel = 0
                l.Position = UDim2.new(x, -TH/2, 7/24, 0)
                l.Size     = UDim2.new(0, TH, 3/24, 0)
                l.ZIndex   = 502
                l.Parent   = icon
            end
            drop(7/24)
            if not isOpen then drop(17/24) end
        end

        -- ---- Draw dashboard (toggle) icon ----
        local function drawDash(b)
            clearIcon(b, "ClimaDash")
            prepButton(b)
            local TH = thick(b)

            local icon = Instance.new("Frame")
            icon.Name = "ClimaDash"
            icon.BackgroundTransparency = 1
            icon.Size = UDim2.fromScale(1, 1)
            icon.ZIndex = 500
            icon.Parent = b

            local function box(x, y, w, h)
                local f = Instance.new("Frame")
                f.BackgroundTransparency = 1
                f.Position = UDim2.fromScale(x, y)
                f.Size     = UDim2.fromScale(w, h)
                f.ZIndex   = 501
                f.Parent   = icon
                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(0, corner(b, 1))
                c.Parent = f
                local s = Instance.new("UIStroke")
                s.Color = ICON_COLOR
                s.Thickness = TH
                s.Parent = f
            end

            box( 3/24,  3/24, 7/24, 9/24)
            box(14/24,  3/24, 7/24, 5/24)
            box(14/24, 12/24, 7/24, 9/24)
            box( 3/24, 16/24, 7/24, 5/24)
        end

        -- ---- Apply ----
        if lockBtn then
            local open = false
            drawLock(lockBtn, false)
            pcall(function()
                lockBtn.MouseButton1Click:Connect(function()
                    open = not open
                    drawLock(lockBtn, open)
                end)
            end)
            print("[Clima] LOCK icon installed on:", lockBtn:GetFullName())
        else
            print("[Clima] !! LOCK button not found - skipping")
        end

        if toggleBtn then
            drawDash(toggleBtn)
            print("[Clima] TOGGLE icon installed on:", toggleBtn:GetFullName())
        else
            print("[Clima] !! TOGGLE button not found - skipping")
        end
    end)
end)

