-- ==================== FISCH AUTO FISH LOGIC ====================
local autoFishRunning = false

task.spawn(function()
    while true() do
        if autoFishRunning then
            pcall(function()
                local char = LocalPlayer.Character
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                
                if char and playerGui then
                    -- 1. Equip rod from Hotbar Slot 1 if not already equipped
                    local equippedTool = char:FindFirstChildOfClass("Tool")
                    if not equippedTool then
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                        task.wait(0.1)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
                        task.wait(0.5)
                        equippedTool = char:FindFirstChildOfClass("Tool")
                    end
                    
                    if equippedTool then
                        local reelGui = playerGui:FindFirstChild("reel")
                        if reelGui and reelGui.Enabled then
                            local bar = reelGui:FindFirstChild("bar", true)
                            local fish = bar and bar:FindFirstChild("fish", true)
                            local playerBar = bar and bar:FindFirstChild("playerbar", true)
                            
                            if fish and playerBar then
                                playerBar.Position = fish.Position
                            end
                        else
                            local shakeGui = playerGui:FindFirstChild("shake")
                            if shakeGui and shakeGui.Enabled then
                                local safeButton = shakeGui:FindFirstChild("safezone", true) or shakeGui:FindFirstChild("button", true)
                                if safeButton then
                                    local absPos = safeButton.AbsolutePosition
                                    local absSize = safeButton.AbsoluteSize
                                    VirtualInputManager:SendMouseButtonEvent(absPos.X + absSize.X/2, absPos.Y + absSize.Y/2, 0, true, game, 1)
                                    VirtualInputManager:SendMouseButtonEvent(absPos.X + absSize.X/2, absPos.Y + absSize.Y/2, 0, false, game, 1)
                                end
                            else
                                equippedTool:Activate()
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

