-- ============================================================
--  6. 💙 APPLY BLUE/CYAN OUTLINE
--  We find every UIStroke in the library's ScreenGui and
--  recolor it. This bypasses Library.Scheme entirely — works
--  even if the scheme key names differ between builds.
-- ============================================================
task.defer(function()
    task.wait(0.1)

    local cyan    = Color3.fromRGB(0, 229, 255)
    local blue    = Color3.fromRGB(30, 144, 255)
    local strokeCount = 0

    -- Find the library's ScreenGui (Obsidian parents it to CoreGui or gethui)
    local containers = {}
    pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
    pcall(function() if gethui then table.insert(containers, gethui()) end end)
    pcall(function() table.insert(containers, game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")) end)

    for _, container in ipairs(containers) do
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("UIStroke") then
                -- Skip strokes inside buttons that would look weird, but
                -- for now just recolor everything to cyan.
                obj.Color = cyan
                obj.Transparency = math.min(obj.Transparency, 0.2)
                obj.Thickness = math.max(obj.Thickness, 1)
                strokeCount = strokeCount + 1
            end
        end
    end

    print("[Clima] Recolored", strokeCount, "UIStrokes to cyan")

    -- Also tint the accent color used by toggles/sliders if the key exists
    pcall(function()
        Library.Scheme.Accent = cyan
        Library.Scheme.Outline = cyan
        Library.Scheme.Toggle = cyan
        Library.Scheme.Slider = cyan
        if Library.UpdateColors then Library.UpdateColors() end
    end)
end)

