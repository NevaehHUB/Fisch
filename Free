-- ============================================================
--  5. 💙 CUSTOM TOGGLE & LOCK ICONS
--  The Lucide SVGs you gave need to be Roblox image assets.
--  I'm using community-uploaded Lucide asset IDs. If these
--  render as a placeholder question mark, the ID is wrong and
--  we swap it — the debug print below will tell us which
--  buttons we found so we can re-target.
-- ============================================================

-- Roblox asset IDs for Lucide icons (community uploads)
local ICON_LOCK   = "rbxassetid://10709788850"   -- lucide "lock"
local ICON_TOGGLE = "rbxassetid://10709788859"   -- lucide "layout-dashboard"
-- Tint color from your SVG stroke: #94cbff
local ICON_TINT   = Color3.fromRGB(148, 203, 255)

task.spawn(function()
    task.wait(0.5)   -- give the library time to finish rendering

    local containers = {}
    pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
    pcall(function() if gethui then table.insert(containers, gethui()) end end)
    pcall(function() table.insert(containers, game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")) end)

    local patched = 0

    local function patchButton(btn)
        if not btn:IsA("ImageButton") then return end
        local n = btn.Name:lower()

        -- Match by common library naming patterns
        if n:find("lock") then
            btn.Image = ICON_LOCK
            btn.ImageColor3 = ICON_TINT
            patched = patched + 1
            print("[Clima] Patched LOCK button:", btn:GetFullName())
        elseif n:find("toggle") or n:find("mobilebutton") or n:find("showhide") then
            btn.Image = ICON_TOGGLE
            btn.ImageColor3 = ICON_TINT
            patched = patched + 1
            print("[Clima] Patched TOGGLE button:", btn:GetFullName())
        end
    end

    -- Initial sweep + debug list
    print("[Clima] --- Scanning ImageButtons ---")
    for _, c in ipairs(containers) do
        for _, obj in ipairs(c:GetDescendants()) do
            if obj:IsA("ImageButton") then
                print("[Clima] Found ImageButton:", obj:GetFullName(),
                      "| Name:", obj.Name,
                      "| Image:", obj.Image)
                patchButton(obj)
            end
        end
    end
    print("[Clima] --- Scan done. Patched:", patched, "---")

    -- Watch for late-spawned buttons (some executors build the mobile
    -- toggle frame lazily, or it appears after the first frame)
    for _, c in ipairs(containers) do
        c.DescendantAdded:Connect(function(obj)
            if obj:IsA("ImageButton") then
                task.wait(0.05)
                patchButton(obj)
            end
        end)
    end
end)

