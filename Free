-- ============================================================
--  💙 BLUE / CYAN THEME (applied AFTER window creation — safest)
--  Wrapped in pcall so a missing Scheme key can never crash.
-- ============================================================
local function applyBlueCyanTheme()
    pcall(function()
        local S = Library.Scheme
        if not S then return end

        local CYAN      = Color3.fromRGB(  0, 229, 255)
        local CYAN_SOFT = Color3.fromRGB(130, 240, 255)
        local BLUE      = Color3.fromRGB( 30, 144, 255)
        local BLUE_DARK = Color3.fromRGB( 10,  60, 130)
        local BG_DARK   = Color3.fromRGB(  8,  16,  28)
        local BG_MID    = Color3.fromRGB( 14,  26,  44)

        S.Main            = BG_DARK
        S.Background      = BG_MID
        S.Popup           = BG_MID

        S.Outline         = CYAN
        S.ButtonBorder    = CYAN
        S.ToggleBorder    = CYAN
        S.SliderBorder    = BLUE
        S.DropdownBorder  = CYAN
        S.TabBorder       = BLUE_DARK

        S.Accent          = CYAN
        S.Button          = BLUE
        S.Toggle          = CYAN
        S.Slider          = CYAN
        S.Dropdown        = BG_MID
        S.Tab             = BG_DARK

        S.FontColor       = CYAN_SOFT
        S.Placeholder     = Color3.fromRGB(120, 180, 210)
        S.Red             = Color3.fromRGB(255,  90, 110)
        S.Green           = Color3.fromRGB(120, 240, 180)

        if Library.UpdateColors  then pcall(Library.UpdateColors)  end
        if Library.RefreshColors then pcall(Library.RefreshColors) end
    end)
end
applyBlueCyanTheme()

print("[Clima] Theme applied")

