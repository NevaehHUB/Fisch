-- ============================================================
--  AGGRESSIVE LOCK/TOGGLE PATCHER
-- ============================================================
local ICON_COLOR = Color3.fromRGB(148, 203, 255)

local function buttonSize(btn)
    local s = btn.AbsoluteSize.X
    if not s or s <= 0 then s = 24 end
    return s
end
local function thickOf(btn) return math.max(1.5, buttonSize(btn) * (2 / 24)) end
local function cornerOf(btn, r) return math.max(2, buttonSize(btn) * (r / 24)) end

local function nukeExistingIcon(btn)
    pcall(function() btn.Image = "" end)
    pcall(function() btn.ImageTransparency = 1 end)
    pcall(function() btn.BackgroundTransparency = 1 end)
    pcall(function() btn.ClipsDescendants = false end)
    pcall(function() btn.AutoButtonColor = false end)
    for _, c in ipairs(btn:GetDescendants()) do
        if c ~= btn then
            if c:IsA("ImageLabel") or c:IsA("ImageButton") then
                pcall(function() c.Image = "" end)
                pcall(function() c.ImageTransparency = 1 end)
                pcall(function() c.Visible = false end)
            elseif c:IsA("TextLabel") or c:IsA("TextButton") then
                pcall(function() c.TextTransparency = 1 end)
                pcall(function() c.Visible = false end)
            elseif c:IsA("Frame") and c.Name == "ClimaIcon" then
                c:Destroy()
            end
        end
    end
end

local function drawLock(btn, isOpen)
    nukeExistingIcon(btn)
    local THICK = thickOf(btn)

    local icon = Instance.new("Frame")
    icon.Name = "ClimaIcon"
    icon.BackgroundTransparency = 1
    icon.Size = UDim2.fromScale(1, 1)
    icon.ZIndex = 1000
    icon.Parent = btn

    local body = Instance.new("Frame")
    body.BackgroundTransparency = 1
    body.Position = UDim2.fromScale(3/24, 10/24)
    body.Size     = UDim2.fromScale(18/24, 12/24)
    body.ZIndex   = 1001
    body.Parent   = icon
    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, cornerOf(btn, 2))
    bc.Parent = body
    local bs = Instance.new("UIStroke")
    bs.Color = ICON_COLOR
    bs.Thickness = THICK
    bs.Parent = body

    local dot = Instance.new("Frame")
    dot.BackgroundColor3 = ICON_COLOR
    dot.BorderSizePixel = 0
    dot.Position = UDim2.fromScale(11/24, 15/24)
    dot.Size     = UDim2.fromScale(2/24, 2/24)
    dot.ZIndex   = 1002
    dot.Parent   = icon
    local dc = Instance.new("UICorner")
    dc.CornerRadius = UDim.new(1, 0)
    dc.Parent = dot

    local clipW = isOpen and (9/24) or (10/24)
    local clip = Instance.new("Frame")
    clip.BackgroundTransparency = 1
    clip.Position = UDim2.fromScale(7/24, 2/24)
    clip.Size     = UDim2.fromScale(clipW, 5/24)
    clip.ClipsDescendants = true
    clip.ZIndex = 1001
    clip.Parent = icon

    local arc = Instance.new("Frame")
    arc.BackgroundTransparency = 1
    arc.Size = UDim2.new((10/24) / clipW, 0, 2, 0)
    arc.ZIndex = 1002
    arc.Parent = clip
    local ac = Instance.new("UICorner")
    ac.CornerRadius = UDim.new(1, 0)
    ac.Parent = arc
    local as_ = Instance.new("UIStroke")
    as_.Color = ICON_COLOR
    as_.Thickness = THICK
    as_.Parent = arc

    local function vline(x)
        local l = Instance.new("Frame")
        l.BackgroundColor3 = ICON_COLOR
        l.BorderSizePixel = 0
        l.Position = UDim2.new(x, -THICK/2, 7/24, 0)
        l.Size     = UDim2.new(0, THICK, 3/24, 0)
        l.ZIndex   = 1002
        l.Parent   = icon
    end
    vline(7/24)
    if not isOpen then vline(17/24) end
end

local function drawDashboard(btn)
    nukeExistingIcon(btn)
    local THICK = thickOf(btn)

    local icon = Instance.new("Frame")
    icon.Name = "ClimaIcon"
    icon.BackgroundTransparency = 1
    icon.Size = UDim2.fromScale(1, 1)
    icon.ZIndex = 1000
    icon.Parent = btn

    local function box(x, y, w, h, r)
        local f = Instance.new("Frame")
        f.BackgroundTransparency = 1
        f.Position = UDim2.fromScale(x, y)
        f.Size     = UDim2.fromScale(w, h)
        f.ZIndex   = 1001
        f.Parent   = icon
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, cornerOf(btn, r))
        c.Parent = f
        local s = Instance.new("UIStroke")
        s.Color = ICON_COLOR
        s.Thickness = THICK
        s.Parent = f
    end

    box( 3/24,  3/24, 7/24, 9/24, 1)
    box(14/24,  3/24, 7/24, 5/24, 1)
    box(14/24, 12/24, 7/24, 9/24, 1)
    box( 3/24, 16/24, 7/24, 5/24, 1)
end

task.spawn(function()
    task.wait(1.5)

    local containers = {}
    pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
    pcall(function() if gethui then table.insert(containers, gethui()) end end)
    pcall(function() table.insert(containers, game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")) end)

    local lockBtn, toggleBtn
    local lockOpen = false

    local function patchLock()
        if not lockBtn then return end
        drawLock(lockBtn, lockOpen)
    end
    local function patchToggle()
        if not toggleBtn then return end
        drawDashboard(toggleBtn)
    end

    print("[Clima] --- IMAGEBUTTON SCAN ---")
    local allBtns = {}
    for _, c in ipairs(containers) do
        for _, obj in ipairs(c:GetDescendants()) do
            if obj:IsA("ImageButton") then
                table.insert(allBtns, obj)
                print("[Clima]  found:", obj.Name, "| size:", obj.AbsoluteSize, "| path:", obj:GetFullName())
            end
        end
    end
    print("[Clima] --- SCAN DONE, total:", #allBtns, "---")

    local function tryMatch(obj)
        if not obj:IsA("ImageButton") then return end
        local n = obj.Name:lower()
        if not lockBtn and n:find("lock") then
            lockBtn = obj
            patchLock()
            lockBtn.MouseButton1Click:Connect(function()
                lockOpen = not lockOpen
                drawLock(lockBtn, lockOpen)
            end)
            print("[Clima] LOCK patched:", lockBtn:GetFullName())
        end
        if not toggleBtn and (n:find("toggle") or n:find("showhide")
            or n:find("mobilebutton") or n:find("menu") or n:find("mobile")) then
            toggleBtn = obj
            patchToggle()
            print("[Clima] TOGGLE patched:", toggleBtn:GetFullName())
        end
    end

    for _, b in ipairs(allBtns) do tryMatch(b) end

    if not lockBtn or not toggleBtn then
        print("[Clima] Name match failed, guessing by size...")
        for _, b in ipairs(allBtns) do
            if b.AbsoluteSize.X > 0 and b.AbsoluteSize.X <= 45 then
                if not toggleBtn and b ~= lockBtn then
                    toggleBtn = b
                    patchToggle()
                    print("[Clima] GUESSED toggle:", b:GetFullName())
                elseif not lockBtn then
                    lockBtn = b
                    patchLock()
                    lockBtn.MouseButton1Click:Connect(function()
                        lockOpen = not lockOpen
                        drawLock(lockBtn, lockOpen)
                    end)
                    print("[Clima] GUESSED lock:", b:GetFullName())
                end
            end
        end
    end

    for _, c in ipairs(containers) do
        c.DescendantAdded:Connect(function(obj)
            task.wait(0.1)
            tryMatch(obj)
        end)
    end

    if not lockBtn   then print("[Clima] !! LOCK BUTTON NOT FOUND !!")   end
    if not toggleBtn then print("[Clima] !! TOGGLE BUTTON NOT FOUND !!") end
end)

