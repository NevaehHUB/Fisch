    Version: v1.0.9 | GUI: Obsidian
    Scoped blue theme (only touches Clima UI, never game UI)
]]

print("[Clima] ===== STARTING =====")

local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library     = loadstring(game:HttpGet(repo .. "Library.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()
print("[Clima] Library loaded:", typeof(Library))

-- ============================================================
--  💙 BLUE THEME — set BEFORE CreateWindow so the library
--  paints itself blue from the start. Never touches game UI.
-- ============================================================
pcall(function()
    local S = Library.Scheme
    if not S then return end

    local CYAN      = Color3.fromRGB(  0, 229, 255)  -- borders / accents
    local CYAN_SOFT = Color3.fromRGB(180, 235, 255)  -- text
    local BLUE      = Color3.fromRGB( 30, 144, 255)  -- button fills
    local BLUE_DARK = Color3.fromRGB( 20,  70, 130)  -- tab backgrounds
    local BG_DARK   = Color3.fromRGB( 10,  18,  30)  -- main background
    local BG_MID    = Color3.fromRGB( 18,  32,  50)  -- panel background

    S.Main           = BG_DARK
    S.Background     = BG_MID
    S.Popup          = BG_MID
    S.Outline        = CYAN
    S.FontColor      = CYAN_SOFT
    S.Button         = BLUE
    S.ButtonBorder   = CYAN
    S.Accent         = CYAN
    S.Toggle         = CYAN
    S.ToggleBorder   = CYAN
    S.Slider         = CYAN
    S.SliderBorder   = BLUE
    S.Dropdown       = BG_MID
    S.DropdownBorder = CYAN
    S.Tab            = BG_DARK
    S.TabBorder      = BLUE_DARK
    S.Textbox        = BG_DARK
    S.Placeholder    = Color3.fromRGB(120, 180, 210)
    S.Red            = Color3.fromRGB(255,  90, 110)
    S.Green          = Color3.fromRGB(120, 240, 180)
end)
print("[Clima] Blue theme applied to Scheme")

-- ============================================================
--  WINDOW
-- ============================================================
local Window = Library:CreateWindow({
    Title             = "Clima",
    Footer            = "v1.0.9",
    Center            = true,
    AutoShow          = true,
    Icon              = 4483345998,
    NotifySide        = "Right",
    ShowCustomCursor  = true,
    MobileButtonsSide = "Right",
})
print("[Clima] Window created")

-- ============================================================
--  TABS
-- ============================================================
local MainTab     = Window:AddTab("Main", "bot")
local SettingsTab = Window:AddTab("UI Settings", "settings")

-- ============================================================
--  MAIN TAB
-- ============================================================
local MainLeft = MainTab:AddGroupbox({ Side = "Left", Name = "Main", IconName = "cog" })
MainLeft:AddLabel("Clima Project — v1.0.9")
MainLeft:AddLabel("All Rights Owned by Eclipse and Selena", true)
MainLeft:AddDivider()

MainLeft:AddToggle("ExampleToggle", {
    Text = "Example Toggle", Default = false,
    Callback = function(v) print("[Clima] toggle:", v) end,
})
MainLeft:AddSlider("ExampleSlider", {
    Text = "Example Slider", Default = 50, Min = 0, Max = 100, Rounding = 0, Suffix = "%",
    Callback = function(v) print("[Clima] slider:", v) end,
})
MainLeft:AddButton({
    Text = "Example Button",
    Func = function()
        Library:Notify({ Title = "Clima", Description = "Button clicked!", Time = 3 })
    end,
})

local MainRight = MainTab:AddGroupbox({ Side = "Right", Name = "Info", IconName = "info" })
MainRight:AddLabel("Clima Project")
MainRight:AddLabel("All Rights Owned by Eclipse and Selena")
MainRight:AddLabel("© 2026 — Do not redistribute")

-- ============================================================
--  UI SETTINGS TAB
-- ============================================================
local MenuGroup = SettingsTab:AddGroupbox({ Side = "Left", Name = "Menu", IconName = "wrench" })
MenuGroup:AddToggle("AlwaysOnTop", {
    Text = "Always On Top", Default = false,
    Callback = function(v) Window:SetAlwaysOnTop(v) end,
})
MenuGroup:AddDropdown("NotificationSide", {
    Values = { "Left", "Right" }, Default = "Right", Text = "Notification Side",
    Callback = function(v) Library:SetNotifySide(v) end,
})
MenuGroup:AddSlider("UICornerSlider", {
    Text = "Corner Radius", Default = Library.CornerRadius or 6,
    Min = 0, Max = 20, Rounding = 0,
    Callback = function(v) Window:SetCornerRadius(v) end,
})
MenuGroup:AddDivider()
MenuGroup:AddLabel("Menu bind"):AddKeyPicker("MenuKeybind", {
    Default = "RightControl", NoUI = true, Text = "Menu keybind",
})
Library.ToggleKeybind = Library.Options.MenuKeybind
MenuGroup:AddButton({ Text = "Unload", Func = function() Library:Unload() end })

-- ============================================================
--  💾 CONFIG GROUP
--  User can save / load / delete named configs from the
--  "Configs" groupbox on the UI Settings tab.
-- ============================================================
SaveManager:SetLibrary(Library)
SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({ "MenuKeybind" })
SaveManager:SetFolder("ClimaProject/configs")
SaveManager:BuildConfigSection(SettingsTab)
SaveManager:LoadAutoloadConfig()
print("[Clima] Config group built")

-- ============================================================
--  DONE
-- ============================================================
Library:Notify({
    Title = "Clima Project",
    Description = "v1.0.9 loaded",
    Time = 5,
})

print("[Clima] ===== DONE =====")
