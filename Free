-- ============================================================
--  5. 💙 CUSTOM LOCK + TOGGLE ICONS (drawn with primitives)
-- ============================================================
local ICON_COLOR = Color3.fromRGB(148, 203, 255)  -- #94cbff

local function iconSizeOf(parent)
    local s = parent.AbsoluteSize.X
    if not s or s <= 0 then s = 24 end
    return s
end

local function iconThickOf(parent)
    return math.max(1.5, iconSizeOf(parent) * (2 / 24))
end

local function iconCornerOf(parent, svgR)
    return math.max(2, iconSizeOf(parent) * (svgR / 24))
end

local function clearClimaIcon(parent)
    for _, c in ipairs(parent:GetChildren()) do
        if c.Name == "ClimaIcon" then c:Destroy() end
    end
end

-- Lock keyhole (closed / open)
local function drawLockKeyhole(parent, isOpen)
    clearClimaIcon(parent)
    local THICK = iconThickOf(parent)

    local icon = Instance.new("Frame")
    icon.Name = "ClimaIcon"
    icon.BackgroundTransparency = 1
    icon.Size = UDim2.fromScale(1, 1)
    icon.ZIndex = 5
    icon.Parent = parent

    -- Body (rounded rect outline)
    local body = Instance.new("Frame")
    body.BackgroundTransparency = 1
    body.Position = UDim2.fromScale(3/24, 10/24)
    body.Size     = UDim2.fromScale(18/24, 12/24)
    body.ZIndex   = 6
    body.Parent   = icon
    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, iconCornerOf(parent, 2))
    bc.Parent = body
    local bs = Instance.new("UIStroke")
    bs.Color = ICON_COLOR
    bs.Thickness = THICK
    bs.Parent = body

    -- Keyhole dot
    local dot = Instance.new("Frame")
    dot.BackgroundColor3 = ICON_COLOR
    dot.BorderSizePixel = 0
    dot.Position = UDim2.fromScale(11/24, 15/24)
    dot.Size     = UDim2.fromScale(2/24, 2/24)
    dot.ZIndex   = 7
    dot.Parent   = icon
    local dc = Instance.new("UICorner")
    dc.CornerRadius = UDim.new(1, 0)
    dc.Parent = dot

    -- Shackle arc (top-half circle, clipped)
    local clipW = isOpen and (9/24) or (10/24)
    local clip = Instance.new("Frame")
    clip.BackgroundTransparency = 1
    clip.Position = UDim2.fromScale(7/24, 2/24)
    clip.Size     = UDim2.fromScale(clipW, 5/24)
    clip.ClipsDescendants = true
    clip.ZIndex = 6
    clip.Parent = icon

    local arc = Instance.new("Frame")
    arc.BackgroundTransparency = 1
    arc.Position = UDim2.new(0, 0, 0, 0)
    arc.Size = UDim2.new((10/24) / clipW, 0, 2, 0)
    arc.ZIndex = 7
    arc.Parent = clip
    local ac = Instance.new("UICorner")
    ac.CornerRadius = UDim.new(1, 0)
    ac.Parent = arc
    local as_ = Instance.new("UIStroke")
    as_.Color = ICON_COLOR
    as_.Thickness = THICK
    as_.Parent = arc

    -- Vertical drops (y=7 → y=10)
    local function vline(x)
        local l = Instance.new("Frame")
        l.BackgroundColor3 = ICON_COLOR
        l.BorderSizePixel = 0
        l.Position = UDim2.new(x, -THICK/2, 7/24, 0)
        l.Size     = UDim2.new(0, THICK, 3/24, 0)
        l.ZIndex   = 7
        l.Parent   = icon
    end
    vline(7/24)
    if not isOpen then
        vline(17/24)
    end
end

-- Layout dashboard (4 outlined rects)
local function drawLayoutDashboard(parent)
    clearClimaIcon(parent)
    local THICK = iconThickOf(parent)

    local icon = Instance.new("Frame")
    icon.Name = "ClimaIcon"
    icon.BackgroundTransparency = 1
    icon.Size = UDim2.fromScale(1, 1)
    icon.ZIndex = 5
    icon.Parent = parent

    local function box(x, y, w, h, r)
        local f = Instance.new("Frame")
        f.BackgroundTransparency = 1
        f.Position = UDim2.fromScale(x, y)
        f.Size     = UDim2.fromScale(w, h)
        f.ZIndex   = 6
        f.Parent   = icon
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, iconCornerOf(parent, r))
        c.Parent = f
        local s = Instance.new("UIStroke")
        s.Color = ICON_COLOR
        s.Thickness = THICK
        s.Parent = f
    end

    box( 3/24,  3/24, 7/24, 9/24, 1)
    box(14/24,  3/24, 7/24, 5/24, 1)
    box(14/24, 12/24, 7/24, 9/24, 1)
    box( 3/24, 16/24, 7/24, 5/24, 1)
end

-- Patch buttons
task.spawn(function()
    task.wait(0.5)

    local containers = {}
    pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
    pcall(function() if gethui then table.insert(containers, gethui()) end end)
    pcall(function() table.insert(containers, game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")) end)

    local lockBtn, toggleBtn
    local lockOpen = false

    local function patchLock()
        if not lockBtn then return end
        lockBtn.Image = ""
        lockBtn.ImageTransparency = 1
        drawLockKeyhole(lockBtn, lockOpen)
    end

    local function patchToggle()
        if not toggleBtn then return end
        toggleBtn.Image = ""
        toggleBtn.ImageTransparency = 1
        drawLayoutDashboard(toggleBtn)
    end

    local function tryMatch(obj)
        if not obj:IsA("ImageButton") then return end
        local n = obj.Name:lower()
        if not lockBtn and n:find("lock") then
            lockBtn = obj
            patchLock()
            lockBtn.MouseButton1Click:Connect(function()
                lockOpen = not lockOpen
                drawLockKeyhole(lockBtn, lockOpen)
            end)
            print("[Clima] Lock button patched:", lockBtn:GetFullName())
        end
        if not toggleBtn and (n:find("toggle") or n:find("showhide")
            or n:find("mobilebutton") or n:find("menu")) then
            toggleBtn = obj
            patchToggle()
            print("[Clima] Toggle button patched:", toggleBtn:GetFullName())
        end
    end

    for _, c in ipairs(containers) do
        for _, obj in ipairs(c:GetDescendants()) do
            tryMatch(obj)
        end
    end

    for _, c in ipairs(containers) do
        c.DescendantAdded:Connect(function(obj)
            task.wait(0.05)
            tryMatch(obj)
        end)
    end

    if not lockBtn   then print("[Clima] Lock button NOT FOUND")   end
    if not toggleBtn then print("[Clima] Toggle button NOT FOUND") end
end)

