local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Options = Library.Options
local Toggles = Library.Toggles

Library.ForceCheckbox = false
Library.ShowToggleFrameInKeybinds = true

local Window = Library:CreateWindow({
    Title = "Clima",
    Footer = "v1.0.4",
    ToggleKeybind = Enum.KeyCode.RightControl,
    Center = true,
    AutoShow = true,
    
    Icon = "cog",
    
    NotifySide = "Right",
    ShowCustomCursor = true,
})

local MainTab = Window:AddTab("Main", "bot")

-- Initialize managers BEFORE we change the colors so they don't overwrite them
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)

----------------------------------------------------------------------
-- FORCE PURE BLUE/CYAN THEME
----------------------------------------------------------------------
local pureCyan = Color3.fromRGB(0, 220, 255)

-- Override the Obsidian/Linoria Theme table directly
Library.Theme.AccentColor = pureCyan
Library.Theme.OutlineColor = pureCyan
Library.Theme.FontColor = Color3.fromRGB(255, 255, 255)
Library.Theme.BackgroundColor = Color3.fromRGB(15, 15, 15)
Library.Theme.MainColor = Color3.fromRGB(20, 20, 20)

-- Safely force the UI to render the new colors over everything
if type(Library.UpdateColorsUsingRegistry) == "function" then
    Library:UpdateColorsUsingRegistry()
end
