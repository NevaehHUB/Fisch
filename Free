                for _, gui in ipairs(CoreGui:GetDescendants()) do
                    if gui:IsA("TextLabel") and gui.Text == "Power" then
                        local parent = gui.Parent
                        while parent and parent ~= CoreGui do
                            if parent:IsA("Frame") and parent.Size.X.Offset >= 300 then
                                parent.Visible = isUIOpen
                                break
                            end
                            parent = parent.Parent
                        end
                    end
                end
            end)
        end)
    end)
