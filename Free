local AllTabs = {}

function CreateTab(tabName, isDefault)
    -- 1. Create Tab Button
    local TabBtn = Instance.new("TextButton")
    TabBtn.Text = tabName
    TabBtn.Size = UDim2.new(0, 0, 1, 0)
    TabBtn.AutomaticSize = Enum.AutomaticSize.X
    TabBtn.BackgroundTransparency = 1
    TabBtn.TextColor3 = isDefault and Cyan or Color3.fromRGB(130, 130, 130)
    TabBtn.Font = Enum.Font.Code
    TabBtn.TextSize = 13
    TabBtn.Parent = TabBar

    -- 2. Create Page Content (Scrolling)
    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = Cyan
    Page.Visible = isDefault or false
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Page.Parent = PageContainer

    -- Columns inside Page
    local LeftCol = Instance.new("Frame")
    LeftCol.Size = UDim2.new(0.49, 0, 0, 0)
    LeftCol.AutomaticSize = Enum.AutomaticSize.Y
    LeftCol.BackgroundTransparency = 1
    LeftCol.Parent = Page

    local RightCol = Instance.new("Frame")
    RightCol.Size = UDim2.new(0.49, 0, 0, 0)
    RightCol.Position = UDim2.new(0.51, 0, 0, 0)
    RightCol.AutomaticSize = Enum.AutomaticSize.Y
    RightCol.BackgroundTransparency = 1
    RightCol.Parent = Page

    local LLayout = Instance.new("UIListLayout")
    LLayout.Padding = UDim.new(0, 8)
    LLayout.Parent = LeftCol

    local RLayout = Instance.new("UIListLayout")
    RLayout.Padding = UDim.new(0, 8)
    RLayout.Parent = RightCol

    -- Tab Click Switcher
    table.insert(AllTabs, {Btn = TabBtn, Page = Page})
    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(AllTabs) do
            t.Page.Visible = false
            t.Btn.TextColor3 = Color3.fromRGB(130, 130, 130)
        end
        Page.Visible = true
        TabBtn.TextColor3 = Cyan
    end)

    return LeftCol, RightCol
end

function CreateSection(column, title)
    local Box = Instance.new("Frame")
    Box.Size = UDim2.new(1, 0, 0, 0)
    Box.AutomaticSize = Enum.AutomaticSize.Y
    Box.BackgroundColor3 = SectionBg
    Box.BorderSizePixel = 0
    Box.Parent = column

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Cyan
    Stroke.Thickness = 1
    Stroke.Parent = Box

    local Header = Instance.new("TextLabel")
    Header.Text = " " .. title
    Header.Size = UDim2.new(1, 0, 0, 20)
    Header.TextColor3 = TextWhite
    Header.Font = Enum.Font.Code
    Header.TextSize = 13
    Header.TextXAlignment = Enum.TextXAlignment.Left
    Header.BackgroundTransparency = 1
    Header.Parent = Box

    local Divider = Instance.new("Frame")
    Divider.Size = UDim2.new(1, 0, 0, 1)
    Divider.Position = UDim2.new(0, 0, 0, 20)
    Divider.BackgroundColor3 = Cyan
    Divider.BorderSizePixel = 0
    Divider.Parent = Box

    local Content = Instance.new("Frame")
    Content.Position = UDim2.new(0, 6, 0, 24)
    Content.Size = UDim2.new(1, -12, 0, 0)
    Content.AutomaticSize = Enum.AutomaticSize.Y
    Content.BackgroundTransparency = 1
    Content.Parent = Box

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 5)
    Layout.Parent = Content

    local Pad = Instance.new("UIPadding")
    Pad.PaddingBottom = UDim.new(0, 8)
    Pad.Parent = Content

    return Content
end

function CreateToggle(section, text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 18)
    Btn.BackgroundTransparency = 1
    Btn.Text = ""
    Btn.Parent = section

    local Box = Instance.new("Frame")
    Box.Size = UDim2.new(0, 12, 0, 12)
    Box.Position = UDim2.new(0, 0, 0.5, -6)
    Box.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    Box.BorderSizePixel = 0
    Box.Parent = Btn

    local Check = Instance.new("Frame")
    Check.Size = UDim2.new(1, -4, 1, -4)
    Check.Position = UDim2.new(0, 2, 0, 2)
    Check.BackgroundColor3 = Cyan
    Check.BorderSizePixel = 0
    Check.Visible = false
    Check.Parent = Box

    local Label = Instance.new("TextLabel")
    Label.Text = text
    Label.Size = UDim2.new(1, -20, 1, 0)
    Label.Position = UDim2.new(0, 20, 0, 0)
    Label.TextColor3 = TextWhite
    Label.Font = Enum.Font.Code
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.BackgroundTransparency = 1
    Label.Parent = Btn

    local State = false
    Btn.MouseButton1Click:Connect(function()
        State = not State
        Check.Visible = State
        if callback then callback(State) end
    end)
end

