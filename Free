-- ==========================================
-- MOBILE DRAG & LOCK FUNCTIONALITY
-- ==========================================
local dragging, dragInput, dragStart, startPos
local isLocked = false

lockBtn.Activated:Connect(function()
    isLocked = not isLocked
    lockBtn.Image = isLocked and ICONS.Lock or ICONS.Unlock
    lockBtn.ImageColor3 = isLocked and OutlineCyan or TextWhite
end)

topBar.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not isLocked then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging and not isLocked then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X, 
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
