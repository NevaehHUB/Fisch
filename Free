local function mod(path)
	local node = RS
	for seg in string.gmatch(path, "[^%.]+") do
		node = node and node:FindFirstChild(seg)
	end
	if not node then return nil end
	local ok, m = pcall(require, node)
	if not ok then return nil end
	return m
end

