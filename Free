local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()
print("[Clima] Library loaded:", typeof(Library))

-- ============================================================
--  SNAPSHOT existing ScreenGuis BEFORE creating our window
--  So we can find OUR ScreenGui afterward by process of
--  elimination. This is how we avoid touching game UI.
-- ============================================================
local before = {}

local function snapshotContainer(container)
    if not container then return end
    local ok, list = pcall(function() return container:GetChildren() end)
    if not ok or not list then return end
    for _, sg in ipairs(list) do
        if sg:IsA("ScreenGui") then
            before[sg] = true
        end
    end
end

snapshotContainer(game:GetService("CoreGui"))
if gethui then pcall(function() snapshotContainer(gethui()) end) end
pcall(function()
    snapshotContainer(game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui", 5))
end)

print("[Clima] Snapshotted", (function() local n = 0 for _ in pairs(before) do n = n + 1 end return n end)(), "existing ScreenGuis")

-- ============================================================
--  WINDOW — default theme, library paints itself normally
-- ============================================================
local Window = Library:CreateWindow({
    Title             = "Clima",
    Footer            = "v1.1.0",
    Center            = true,
    AutoShow          = true,
    Icon              = 4483345998,
    NotifySide        = "Right",
    ShowCustomCursor  = true,
    MobileButtonsSide = "Right",
})
print("[Clima] Window created")

-- ============================================================
--  FIND our newly-created ScreenGui and recolor ONLY its
--  UIStrokes. No game UI is ever touched.
-- ============================================================
local climaGui = nil

local function findNewGui(container)
    if climaGui or not container then return end
    local ok, list = pcall(function() return container:GetChildren() end)
    if not ok or not list then return end
    for _, sg in ipairs(list) do
        if sg:IsA("ScreenGui") and not before[sg] then
            climaGui = sg
            return
        end
    end
end

findNewGui(game:GetService("CoreGui"))
if not climaGui and gethui then pcall(function() findNewGui(gethui()) end) end
if not climaGui then
    pcall(function() findNewGui(game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui", 5)) end)
end

if climaGui then
    print("[Clima] Found Clima ScreenGui:", climaGui.Name, "| path:", climaGui:GetFullName())

    local cyan      = Color3.fromRGB(0, 229, 255)
    local cyanSoft  = Color3.fromRGB(180, 235, 255)
    local blue      = Color3.fromRGB(30, 144, 255)
    local strokeN, labelN = 0, 0

    -- Recolor only strokes + text inside OUR ScreenGui
    for _, obj in ipairs(climaGui:GetDescendants()) do
        if obj:IsA("UIStroke") then
            obj.Color = cyan
            obj.Transparency = math.min(obj.Transparency, 0.2)
            obj.Thickness = math.max(obj.Thickness, 1)
            strokeN = strokeN + 1
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
            pcall(function()
                obj.TextColor3 = cyanSoft
            end)
            labelN = labelN + 1
        end
    end

    print("[Clima] Recolored", strokeN, "strokes and", labelN, "labels — Clima only")
else
    print("[Clima] !! Could not locate Clima ScreenGui — theme left default")
end

