-- ==================== REBUILT AUTO FISH LOGIC ====================
local getgenv = getgenv or function() return _G end
getgenv().AutoFish = false

local function clickButton(button)
    -- Method 1: Executor bypass (Extremely reliable on mobile)
    if getconnections then
        for _, conn in pairs(getconnections(button.MouseButton1Click)) do
            conn:Fire()
        end
        for _, conn in pairs(getconnections(button.Activated)) do
            conn:Fire()
        end
    end
    
    -- Method 2: VirtualInputManager Fallback (With GuiInset correction)
    local guiInset = game:GetService("GuiService"):GetGuiInset()
    local absPos = button.AbsolutePosition
    local absSize = button.AbsoluteSize
    local clickX = absPos.X + (absSize.X / 2)
    local clickY = absPos.Y + (absSize.Y / 2) + guiInset.Y
    
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)
end

task.spawn(function()
    while true do
        if getgenv().AutoFish then
            pcall(function()
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                
                if char and hum and playerGui then
                    -- 1. FOOLPROOF EQUIPPING (Checks Character, then Backpack)
                    local rod = char:FindFirstChildOfClass("Tool") 
                    if not rod then
                        local backpack = LocalPlayer:FindFirstChild("Backpack")
                        rod = backpack and backpack:FindFirstChildOfClass("Tool")
                        if rod then
                            hum:EquipTool(rod)
                            task.wait(0.2)
                        end
                    end
                    
                    if rod then
                        -- 2. REEL MINIGAME LOGIC
                        local reelGui = playerGui:FindFirstChild("reel")
                        if reelGui and reelGui.Enabled then
                            local bar = reelGui:FindFirstChild("bar", true)
                            if bar then
                                local fish = bar:FindFirstChild("fish")
                                local pBar = bar:FindFirstChild("playerbar")
                                if fish and pBar then
                                    pBar.Position = fish.Position -- Lock bar to fish
                                end
                            end
                            
                        -- 3. SHAKE MINIGAME LOGIC
                        else
                            local shakeGui = playerGui:FindFirstChild("shake")
                            if shakeGui and shakeGui.Enabled then
                                -- Find the button no matter what it's named internally
                                local safeBtn = shakeGui:FindFirstChild("safezone", true) 
                                             or shakeGui:FindFirstChild("button", true) 
                                             or shakeGui:FindFirstChildOfClass("ImageButton", true)
                                             or shakeGui:FindFirstChildOfClass("TextButton", true)
                                
                                if safeBtn then
                                    clickButton(safeBtn)
                                end
                                
                        -- 4. CASTING LOGIC
                            else
                                rod:Activate()
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.05) -- Fast loop for better minigame tracking
    end
end)

